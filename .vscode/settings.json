{
    // -- Python / Zephyr environment -----------------------------------------
    "python.defaultInterpreterPath": "${env:HOME}/zephyr-venv/bin/python3",
    "python.terminal.activateEnvironment": true,
    "python.terminal.activateEnvInCurrentTerminal": true,
    "terminal.integrated.env.linux": {
        "VIRTUAL_ENV": "${env:HOME}/zephyr-venv",
        "ZEPHYR_BASE": "${workspaceFolder}/zephyr",
        "ZEPHYR_SDK_INSTALL_DIR": "${env:HOME}/zephyr-sdk-1.0.1"
    },

    // -- Cortex-Debug (J-Link / OpenOCD via Zephyr SDK) ----------------------
    "cortex-debug.armToolchainPath": "${env:HOME}/zephyr-sdk-1.0.1/arm-zephyr-eabi/bin",
    "cortex-debug.openocdPath": "${env:HOME}/zephyr-sdk-1.0.1/hosttools/sysroots/x86_64-pokysdk-linux/usr/bin/openocd",
    "cortex-debug.gdbPath": "${env:HOME}/zephyr-sdk-1.0.1/arm-zephyr-eabi/bin/arm-zephyr-eabi-gdb",
    "cortex-debug.armToolchainPrefix": "arm-zephyr-eabi",
    "cortex-debug.variableUseNaturalFormat": false,

    // -- C/C++ IntelliSense --------------------------------------------------
    "cmake.configureOnOpen": false,
    "C_Cpp.default.defines": [
        "__CDT_PARSER__"
    ],
    "C_Cpp.default.forcedInclude": [
        "${workspaceFolder}/app/build-pico2-wh/zephyr/include/generated/zephyr/autoconf.h"
    ],
    "C_Cpp.default.includePath": [
        "${workspaceFolder}/**",
        "${workspaceFolder}/zephyr/include/**"
    ],
    "C_Cpp.default.mergeConfigurations": true,
    "C_Cpp.default.compileCommands": "${workspaceFolder}/app/build-pico2-wh/compile_commands.json",
    "C_Cpp.default.cStandard": "c11",
    "C_Cpp.default.cppStandard": "c++20",
    "C_Cpp.default.intelliSenseMode": "linux-gcc-x64",
    "C_Cpp.inactiveRegionOpacity": 1,
    "C_Cpp.inactiveRegionBackgroundColor": "#000000",
    "C_Cpp.inactiveRegionForegroundColor": "#ffffff",

    "files.associations": {
        "types.h": "c"
    },
    "cdt.debug.sourceHighlighting": false,
    "cmake.sourceDirectory": "/wsl.localhost/Ubuntu-24.04/home/dai/WebinarEmbarcados2026/app"
}
